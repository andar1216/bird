{
  "name": "bird",
  "productName": "Bird",
  "description": "Unified messenger shell for Instagram, Snapchat, Google Messages and Discord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -s first -n vite,electron \"vite\" \"wait-on http://localhost:5173 && cross-env BIRD_DEV_URL=http://localhost:5173 electron .\"",
    "electron:start": "vite build && electron .",
    "db": "npm --prefix server run db",
    "server": "npm --prefix server run dev",
    "server:test": "npm --prefix server test"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
