# Copy to server/.env to override defaults.
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bird
# Test suite uses its own database (it is dropped on every run!).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/bird_test
# Comma separated. "null" is the packaged Electron app (file://).
CORS_ORIGINS=http://localhost:5173,null
SESSION_DAYS=30
AUTH_RATE_LIMIT=50
